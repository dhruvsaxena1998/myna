{
  "manifest_version": 3,
  "name": "Myna",
  "version": "0.1.0",
  "description": "Lets Myna see your Teams call: mute state, the call tab's sound and who is talking.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*"],
  "content_scripts": [{ "matches": ["https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{ "resources": ["selectors.js"], "matches": ["https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*"] }],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Myna", "default_popup": "popup.html" }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Myna",
  "version": "0.1.0",
  "identifier": "com.dhruvsaxena.myna",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$DATA/Myna/screenshots/**", "$DATA/Myna/audio/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": { "../extension": "extension" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "14.2" }
  }
}
